# Copy this file to the Daedalus launch-root .env and fill in local credentials.
# This file is the canonical shared source for every registered project's
# personal Supabase connection. Never commit the resulting .env.
CURSOR_API_KEY=

# Shared personal Supabase project.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set at least one database access method for launch-time migration pushes.
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
