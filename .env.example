# Copy this file to the Daedalus launch-root .env and fill in local credentials.
# This file is the canonical shared source for every registered project's
# personal Supabase connection. Never commit the resulting .env.
CURSOR_API_KEY=

# Shared personal Supabase — Dashboard → Project Settings → API Keys.
# Prefer the new publishable + secret keys (sb_publishable_… / sb_secret_…).
# Legacy SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY still work as aliases.
# SUPABASE_PRIVATE_KEY is also accepted as an alias for the secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional when SUPABASE_URL is https://<project-ref>.supabase.co (derived automatically).
# SUPABASE_PROJECT_REF=
# Database access for Activate / migration push (API keys cannot push SQL). Pick one:
SUPABASE_DB_URL=
# SUPABASE_ACCESS_TOKEN=
