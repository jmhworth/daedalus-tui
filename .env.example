# Copy this file to the Daedalus TUI package-root .env and set local credentials.
# CURSOR_API_KEY is used for Cursor agent processes. Target projects do not
# need a copy; project and launch-directory .env files are not passed to agents.
# Never commit the resulting .env.
CURSOR_API_KEY=

# Shared personal Supabase project (fill in from the operator dashboard).
# Never commit real keys; copy this file to .env locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct database URL for CLI workflows:
SUPABASE_DB_URL=

# Project-specific Postgres schema on the shared database (never use public).
SUPABASE_SCHEMA=daedalus-tui

# After migrations apply, allow-list schema "daedalus-tui" in Supabase Dashboard → Project Settings → Data API (PostgREST exposed schemas).
