#screen {
    background: $surface;
    layers: checkerboard content;
    height: 1fr;
    padding: 1 2;
    overflow-x: hidden;
}

Screen > .screen--selection {
    /* Use solid shared colors so selection remains consistent across surfaces. */
    background: $primary;
    color: $foreground;
}

#prompt-input > .text-area--selection {
    background: $primary;
    color: $foreground;
}

#workspace {
    layer: content;
    height: 1fr;
}

#task-sidebar {
    width: 32;
    min-width: 29;
    height: 1fr;
    border: round $primary;
    padding: 1;
}

#task-list {
    height: 1fr;
    /* The inbox columns have fixed cell widths; never introduce a second
       layout by horizontally scrolling when an update marker appears. */
    overflow-x: hidden;
}

#project-main {
    width: 1fr;
    padding-left: 1;
}

#project-label {
    width: 9;
    color: $text-muted;
}

#project-select {
    width: 1fr;
    margin-right: 1;
}

#task-label {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

/* The project selector now sits in the task toolbar. */
#task-bar #project-label {
    height: auto;
    margin-right: 1;
}

#task-bar #project-select {
    width: 1fr;
}

#title {
    color: $text-accent;
    text-style: bold;
}

#settings {
    height: 3;
    align: left middle;
}

#compact-settings {
    display: none;
    height: auto;
}

#task-bar {
    height: 3;
    align: left middle;
}

#settings Select {
    width: 1fr;
    margin-right: 1;
}

#view-topic-button {
    width: 13;
    margin-right: 1;
}

#codex-usage, #title, #task-context, #status,
#resume-notes-label {
    color: $text-muted;
    pointer: text;
}

#codex-usage {
    height: auto;
    min-height: 1;
}

#task-context {
    color: $text-muted;
    height: 1;
}

#agent-state-row {
    height: 1;
    align: left middle;
}

#output-panel {
    height: 1fr;
    min-height: 1;
}

#output-toolbar {
    height: 1;
    align: left middle;
}

#output-view-label {
    width: 1fr;
    color: $text-accent;
    text-style: bold;
}

#agent-spinner {
    width: 3;
    height: 1;
    display: none;
    color: $text-accent;
}

#agent-outcome {
    width: auto;
    height: 1;
    margin-left: 1;
    color: $text-muted;
    text-style: bold;
}

#agent-outcome.outcome-success {
    color: $success;
}

#agent-outcome.outcome-failure {
    color: $error;
}

#agent-outcome.outcome-input {
    color: $warning;
}

#output {
    height: 1fr;
    min-height: 1;
    border: round $primary;
    padding: 1;
}

#output {
    height: 1fr;
    box-sizing: border-box;
    /* Leave a small buffer so the readable transcript does not run into the edge. */
    width: 95%;
    border: round $primary;
    padding: 1;
    overflow-x: hidden;
    display: block;
    /* Keep progress narration quiet until the agent's final summary. */
    color: $text-disabled;
}

#plan-review {
    display: none;
    height: 1fr;
    border: round $primary;
    padding: 1;
    overflow-y: auto;
}

#plan-display {
    color: $text;
    height: auto;
    margin-bottom: 1;
}

#plan-questions {
    height: auto;
}

.plan-questions-heading {
    color: $text-accent;
    text-style: bold;
    height: 1;
}

.plan-question {
    color: $text;
    height: auto;
    width: 1fr;
    margin-top: 1;
}

.plan-answer-row {
    height: auto;
    width: 1fr;
    align: left middle;
    margin-top: 1;
}

.plan-clarify-button {
    width: 5;
    min-width: 5;
    height: 3;
    margin-left: 1;
}

#plan-questions .plan-answer-select {
    width: 1fr;
}

#plan-questions Select {
    width: 1fr;
}

#plan-questions .plan-custom-answer {
    width: 1fr;
    height: 3;
    margin-top: 1;
    display: none;
}

#plan-questions .plan-clarification-select {
    width: 1fr;
    margin-top: 1;
}

#plan-questions .plan-clarification-answer {
    width: 1fr;
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#plan-actions {
    height: 3;
    align: left middle;
    margin-top: 1;
}

#answer-plan-button, #implement-button {
    width: 18;
    margin-right: 1;
}

#implement-button.implemented {
    color: $text-disabled;
    opacity: 0.55;
}

#prompt-input {
    color: $text;
}

#prompt-input.-read-only {
    /* Submitted prompts are still selectable, but are no longer editable. */
    color: $text-disabled 75%;
}

#composer {
    height: auto;
    min-height: 7;
}

#prompt-input {
    height: 7;
    border: round $secondary;
}

#resume-notes-panel {
    display: none;
    height: 5;
}

#resume-notes-label {
    color: $text-muted;
    height: 1;
}

#resume-notes {
    height: 3;
    border: round $secondary;
}

#actions {
    height: 3;
    align: left middle;
}

#send-button {
    width: 12;
    margin-right: 2;
}

#continue-plan-button {
    width: 16;
    margin-right: 1;
}

#pause-button, #resume-button, #cancel-button {
    width: 11;
    margin-right: 1;
}

#retry-button {
    width: 11;
    margin-right: 1;
}

#status {
    color: $text-muted;
}

/* The Clown theme gives the workspace a spectrum palette over a soft checkerboard. */
#clown-checkerboard {
    /* Keep the decorative widget out of the scroll layout for flat themes. */
    display: none;
}

#screen.clown-theme #clown-checkerboard {
    display: block;
    layer: checkerboard;
    position: absolute;
    width: 1fr;
    height: 1fr;
    color: rgba(255, 255, 255, 0.08);
    background: transparent;
    overflow: hidden;
}

#screen.clown-theme #task-sidebar {
    background: rgba(255, 51, 79, 0.18);
    border: round #ff334f;
}

#screen.clown-theme #task-label,
#screen.clown-theme #title {
    color: #ff4d5a;
}

#screen.clown-theme #project-label,
#screen.clown-theme #project-select {
    color: #ff9e24;
}

#screen.clown-theme #project-select {
    background: rgba(255, 158, 36, 0.16);
}

#screen.clown-theme #task-bar {
    border-bottom: solid #ff9e24;
}

#screen.clown-theme #codex-usage {
    color: #ffd43b;
}

#screen.clown-theme #task-context,
#screen.clown-theme #agent-state-row {
    color: #52dc76;
}

#screen.clown-theme #output-view-label,
#screen.clown-theme #agent-spinner {
    color: #39c5ff;
}

#screen.clown-theme #output-toolbar {
    border-bottom: solid #39c5ff;
}

#screen.clown-theme #output {
    background: rgba(39, 191, 112, 0.18);
    border: round #39d98a;
}

#screen.clown-theme #prompt-input,
#screen.clown-theme #resume-notes {
    background: rgba(77, 114, 255, 0.17);
    border: round #4d72ff;
}

#screen.clown-theme #plan-review {
    border: round #b35cff;
}

#screen.clown-theme #resume-notes-panel {
    border-left: solid #ff4d5a;
}

#screen.clown-theme #settings {
    border-bottom: solid #ffd43b;
}

/* Narrow terminals use a scrollable vertical workspace and a three-column settings grid. */
#screen.compact-width {
    padding: 1;
}

#screen.compact-width #workspace {
    layout: vertical;
    height: auto;
}

#screen.compact-width #task-sidebar {
    width: 1fr;
    min-width: 0;
    height: 14;
    padding: 1;
}

#screen.compact-width #task-list {
    width: 1fr;
    min-width: 0;
}

#screen.compact-width #project-main {
    width: 1fr;
    height: auto;
    padding-left: 0;
}

#screen.compact-width #settings {
    display: block;
    layout: grid;
    width: 1fr;
    height: auto;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-gutter: 1;
}

#screen.compact-width #compact-settings {
    display: none;
}

#screen.compact-width #settings > * {
    width: 1fr;
    margin-right: 0;
}

#screen.compact-width #settings Button {
    width: 1fr;
}

#screen.compact-width #task-bar {
    layout: vertical;
    height: auto;
    align: left top;
}

#screen.compact-width #task-bar > * {
    width: 1fr;
    margin-right: 0;
}

#screen.compact-width #task-bar #project-label {
    height: 1;
    margin-right: 0;
}

#screen.compact-width #task-bar Button {
    height: 3;
}

#screen.compact-width #output {
    width: 1fr;
}

#screen.compact-width #output-panel {
    min-height: 8;
}

/* Short terminals keep the output flexible by reducing surrounding chrome. */
#screen.short-height #task-context {
    height: 1;
}

#screen.short-height #actions,
#screen.short-height #plan-actions {
    height: 2;
}

#screen.short-height #resume-notes-panel {
    height: 4;
}

#screen.short-height #resume-notes {
    height: 2;
}

#screen.short-height #actions Button,
#screen.short-height #plan-actions Button {
    height: 2;
}

KeyboardShortcutsScreen {
    align: center middle;
}

CodingStatisticsScreen {
    align: center middle;
}

ProjectInitializerScreen {
    align: center middle;
}

PersonalSupabaseConfirmationScreen {
    align: center middle;
}

PersonalSupabaseSetupWizardScreen {
    align: center middle;
}

PersonalSupabaseActivationProgressScreen {
    align: center middle;
}

CreateTopicScreen {
    align: center middle;
}

CommandMenuScreen {
    align: center middle;
}

TopicViewerScreen {
    align: center middle;
}

#topic-view-dialog {
    width: 90%;
    height: 85%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#topic-view-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#topic-view-subtitle {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

#topic-view-content {
    height: 1fr;
    border: round $primary;
    margin-bottom: 1;
}

#topic-view-actions {
    height: 3;
    align: right middle;
}

#close-topic-view-button {
    width: 10;
}

#create-topic-dialog {
    width: 82;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#create-topic-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#create-topic-subtitle, #topic-name-label, #topic-goal-label, #create-topic-status {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#topic-name-input {
    margin-bottom: 1;
}

#topic-goal-input {
    height: 10;
    margin-bottom: 1;
}

#create-topic-actions {
    height: 3;
    align: left middle;
}

#create-topic-button, #cancel-topic-button {
    width: 20;
    margin-right: 1;
}

#project-initializer-dialog {
    width: 72;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#project-initializer-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#project-initializer-subtitle, #project-name-label, #project-initializer-status {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

#project-name-input {
    margin-bottom: 1;
}

#project-github-checkbox {
    margin-bottom: 1;
}

#personal-supabase-confirmation-dialog {
    width: 76;
    height: auto;
    border: round $error;
    background: $surface;
    padding: 1 2;
}

#personal-supabase-confirmation-title {
    color: $error;
    text-style: bold;
    height: 2;
}

#personal-supabase-confirmation-warning,
#personal-supabase-confirmation-prompt,
#personal-supabase-confirmation-status {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#personal-supabase-confirmation-prompt {
    color: $text;
}

#personal-supabase-confirmation-input {
    margin-bottom: 1;
}

#personal-supabase-confirmation-actions {
    height: 3;
    align: left middle;
}

#confirm-personal-supabase-button,
#cancel-personal-supabase-button {
    width: 20;
    margin-right: 1;
}

#personal-supabase-wizard-dialog {
    width: 78;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#personal-supabase-wizard-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#personal-supabase-wizard-scaffold,
#personal-supabase-wizard-instructions,
#personal-supabase-wizard-status {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#personal-supabase-wizard-scaffold {
    color: $text;
}

#personal-supabase-wizard-actions {
    height: 3;
    align: left middle;
}

#continue-personal-supabase-wizard-button,
#cancel-personal-supabase-wizard-button {
    width: 20;
    margin-right: 1;
}

#personal-supabase-removal-dialog {
    width: 76;
    height: auto;
    border: round $error;
    background: $surface;
    padding: 1 2;
}

#personal-supabase-removal-title {
    color: $error;
    text-style: bold;
    height: 2;
}

#personal-supabase-removal-warning,
#personal-supabase-removal-prompt,
#personal-supabase-removal-status {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#personal-supabase-removal-prompt {
    color: $text;
}

#personal-supabase-removal-input {
    margin-bottom: 1;
}

#personal-supabase-removal-actions {
    height: 3;
    align: left middle;
}

#confirm-personal-supabase-removal-button,
#cancel-personal-supabase-removal-button {
    width: 20;
    margin-right: 1;
}

#personal-supabase-progress-dialog {
    width: 76;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#personal-supabase-progress-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#personal-supabase-progress-subtitle,
#personal-supabase-progress-status {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#personal-supabase-progress-bar {
    margin-bottom: 1;
}

#personal-supabase-progress-steps {
    height: auto;
    margin-bottom: 1;
}

#personal-supabase-progress-steps Static {
    height: 1;
}

#personal-supabase-exposure-error-dialog {
    width: 76;
    height: auto;
    max-height: 90%;
    border: round $error;
    background: $surface;
    padding: 1 2;
}

#personal-supabase-exposure-error-title {
    color: $error;
    text-style: bold;
    height: 2;
}

#personal-supabase-exposure-error-intro {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#personal-supabase-exposure-error-scroll {
    height: auto;
    max-height: 1fr;
    min-height: 3;
    border: round $error;
    padding: 1;
    margin-bottom: 1;
}

#personal-supabase-exposure-error-detail {
    width: 1fr;
    height: auto;
    color: $text;
}

#personal-supabase-exposure-error-actions {
    height: 3;
    align: left middle;
}

#personal-supabase-progress-actions {
    height: 3;
    align: left middle;
}

#close-personal-supabase-progress-button {
    width: 20;
}

#project-initializer-actions {
    height: 3;
    align: left middle;
}

#plan-clarification-dialog {
    width: 72;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#plan-clarification-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#plan-clarification-question {
    color: $text;
    height: auto;
    margin-bottom: 1;
}

#plan-clarification-subtitle {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#plan-clarification-input {
    height: 6;
    margin-bottom: 1;
}

#plan-clarification-actions {
    height: 3;
    align: left middle;
}

#coding-statistics-dialog {
    width: 94%;
    height: 88%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#coding-statistics-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#coding-statistics-subtitle, #coding-statistics-footer {
    color: $text-muted;
    height: 1;
}

#coding-statistics-controls {
    height: 3;
    align: left middle;
}

#statistics-unit-label {
    width: 9;
    color: $text-muted;
}

#statistics-unit-select {
    width: 18;
}

#coding-statistics-summary {
    height: 5;
    margin-top: 1;
}

.usage-metric {
    width: 1fr;
    border: round $secondary;
    padding: 1;
    color: $text-accent;
    text-style: bold;
    margin-right: 1;
}

#coding-statistics-body {
    height: 1fr;
    margin-top: 1;
}

#usage-history-panel {
    width: 58%;
    border: round $primary;
    padding: 1;
    margin-right: 1;
}

#usage-breakdown-panel {
    width: 42%;
    border: round $primary;
    padding: 1;
}

.statistics-heading {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

.statistics-value {
    color: $text;
    height: 3;
    margin-bottom: 1;
}

#provider-split {
    height: auto;
}

#usage-table {
    height: 1fr;
}

#shortcuts-dialog {
    width: 72;
    max-height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#command-menu-dialog {
    width: 58;
    height: 80%;
    max-height: 34;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#command-menu-tabs {
    height: 1fr;
}

#command-menu-tabs TabPane {
    padding: 1 0 0 0;
}

.command-actions {
    height: 1fr;
}

.appearance-copy {
    color: $text-muted;
    height: 2;
    margin-bottom: 1;
}

#theme-picker-dialog {
    width: 48;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#theme-picker-dialog Button {
    width: 1fr;
    margin-bottom: 1;
}

#theme-picker-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#theme-picker-subtitle {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

#command-menu-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#command-menu-subtitle {
    color: $text-muted;
    height: 2;
    margin-bottom: 1;
}

#command-menu-dialog Button {
    width: 1fr;
    margin-bottom: 1;
}

#shortcuts-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#shortcuts-subtitle {
    color: $text-muted;
    height: 2;
}

.shortcut-section {
    color: $text-accent;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

.shortcut-row {
    height: 1;
}
