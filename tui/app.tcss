Screen {
    background: $surface;

    /* Keep selectable output as readable as the prompt editor selection. */
    & > .screen--selection {
        background: $input-selection-background;
        color: $input-selection-foreground;
    }
}

#screen {
    height: 1fr;
    padding: 1 2;
}

#workspace {
    height: 1fr;
}

/* The main workspace (task inbox + composer/output) and the optional viewer
   are siblings so the viewer can take one third of the whole usable width. */
#main-workspace {
    width: 1fr;
    height: 1fr;
}

#output-viewer {
    display: none;
    width: 1fr;
    height: 1fr;
    margin-left: 1;
}

#workspace.viewer-visible #main-workspace {
    width: 2fr;
}

#workspace.viewer-visible #output-viewer {
    display: block;
}

/* Narrow terminals show the same viewer as a full-width alternate view. */
#workspace.viewer-full #main-workspace {
    display: none;
}

#workspace.viewer-full #output-viewer {
    display: block;
    width: 1fr;
    margin-left: 0;
}

#task-sidebar {
    width: 44;
    min-width: 22;
    height: 1fr;
    border: round $primary;
    padding: 1;
}

#task-list {
    height: 1fr;
    /* The inbox columns have fixed cell widths; never introduce a second
       layout by horizontally scrolling when an update marker appears. */
    overflow-x: hidden;
}

#history-toggle-button {
    width: 1fr;
    height: 3;
    margin-top: 1;
}

#usage-bar {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#screen.compact-width #usage-bar {
    display: none;
}

#project-main {
    width: 1fr;
    padding-left: 1;
}

#project-label {
    width: 9;
    color: $text-muted;
}

#project-select {
    width: 1fr;
    margin-right: 1;
}

#task-label {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

/* The project selector now sits in the task toolbar. */
#task-bar #project-label {
    height: auto;
    margin-right: 1;
}

#task-bar #project-select {
    width: 1fr;
}

#title {
    color: $text-accent;
    text-style: bold;
}

#settings {
    height: 3;
    align: left middle;
}

#compact-settings {
    display: none;
    height: auto;
}

#task-bar {
    height: 3;
    align: left middle;
}

#new-task-button {
    width: 14;
}

#new-project-button, #create-topic-button, #register-backend-button, #sign-in-button {
    width: auto;
    min-width: 16;
    margin-right: 1;
}

#settings Select {
    width: 1fr;
    margin-right: 1;
}

#settings Button {
    min-width: 0;
}

#view-topic-button {
    width: 13;
    margin-right: 1;
}

#push-branch-button {
    width: 10;
}

#push-history-button {
    width: 12;
    margin-left: 1;
}

#directory, #phase, #title, #task-context, #status,
#resume-notes-label {
    color: $text-muted;
    pointer: text;
}

#directory, #phase {
    height: 1;
}

#task-context {
    color: $text-muted;
    height: 2;
}

#output-panel {
    height: 1fr;
    min-height: 1;
}

#output-toolbar {
    height: 3;
    align: left middle;
}

#output-view-label {
    width: 1fr;
    color: $text-accent;
    text-style: bold;
}

#output-toggle-button {
    width: 21;
    margin-right: 1;
}

#viewer-toggle-button {
    width: 15;
}

#task-error, #output {
    height: 1fr;
    min-height: 1;
    border: round $primary;
    padding: 1;
}

#task-error {
    display: none;
    color: $error;
    border: round $error;
}

#output {
    height: 1fr;
    box-sizing: border-box;
    /* Leave a small buffer so the readable transcript does not run into the edge. */
    width: 95%;
    border: round $primary;
    padding: 1;
    overflow-x: hidden;
    display: block;
    /* Keep progress narration quiet until the agent's final summary. */
    color: $text-disabled;
}

#plan-review {
    display: none;
    height: 1fr;
    border: round $primary;
    padding: 1;
    overflow-y: auto;
}

#plan-display {
    color: $text;
    height: auto;
    margin-bottom: 1;
}

#plan-questions {
    height: auto;
}

.plan-questions-heading {
    color: $text-accent;
    text-style: bold;
    height: 1;
}

.plan-question {
    color: $text;
    height: auto;
    width: 1fr;
    margin-top: 1;
}

.plan-answer-row {
    height: auto;
    width: 1fr;
    align: left middle;
    margin-top: 1;
}

.plan-clarify-button {
    width: 5;
    min-width: 5;
    height: 3;
    margin-left: 1;
}

#plan-questions .plan-answer-select {
    width: 1fr;
}

#plan-questions Select {
    width: 1fr;
}

#plan-questions .plan-custom-answer {
    width: 1fr;
    height: 3;
    margin-top: 1;
    display: none;
}

#plan-questions .plan-clarification-select {
    width: 1fr;
    margin-top: 1;
}

#plan-questions .plan-clarification-answer {
    width: 1fr;
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

#plan-actions {
    height: 3;
    align: left middle;
    margin-top: 1;
}

#answer-plan-button, #implement-button {
    width: 18;
    margin-right: 1;
}

#implement-button.implemented {
    color: $text-disabled;
    opacity: 0.55;
}

#prompt-input {
    color: $text;
}

#prompt-input.-read-only {
    /* Submitted prompts are still selectable, but are no longer editable. */
    color: $text-disabled 75%;
}

#composer {
    height: auto;
    min-height: 7;
}

#task-title {
    height: 1;
    color: $text-accent;
    text-style: bold;
}

#composer-tools {
    height: 3;
    align: left middle;
}

#prompt-history-select {
    width: 1fr;
    max-width: 60;
}

#vim-mode {
    width: 10;
    color: $text-muted;
    text-style: bold;
}

#prompt-input {
    height: 7;
    border: round $secondary;
}

#resume-notes-panel {
    display: none;
    height: 5;
}

#resume-notes-label {
    color: $text-muted;
    height: 1;
}

#resume-notes {
    height: 3;
    border: round $secondary;
}

#actions {
    height: 3;
    align: left middle;
}

#send-button {
    width: 12;
    margin-right: 2;
}

#continue-plan-button, #start-coding-button {
    width: 16;
    margin-right: 1;
}

#pause-button, #resume-button, #cancel-button {
    width: 11;
    margin-right: 1;
}

#retry-button {
    width: 11;
    margin-right: 1;
}

#status {
    color: $text-muted;
}

/* Narrow terminals use a vertical workspace and a two-level settings picker. */
#screen.compact-width {
    padding: 1;
}

#screen.compact-width #main-workspace {
    layout: vertical;
}

#screen.compact-width #history-toggle-button {
    display: none;
}

#screen.compact-width #task-sidebar {
    width: 1fr;
    min-width: 0;
    height: 8;
    padding: 1;
}

#screen.compact-width #composer-tools {
    display: none;
}

#screen.compact-width #project-main {
    width: 1fr;
    height: 1fr;
    min-height: 1;
    padding-left: 0;
}

#screen.compact-width #settings {
    display: none;
}

#screen.compact-width #compact-settings {
    display: block;
    width: 1fr;
    height: 7;
}

#screen.compact-width #compact-settings Select {
    width: 1fr;
    margin-bottom: 0;
}

#screen.compact-width #compact-settings-category {
    margin-bottom: 1;
}

#screen.compact-width #task-bar {
    layout: vertical;
    height: auto;
    align: left top;
}

#screen.compact-width #task-bar > * {
    width: 1fr;
    margin-right: 0;
}

#screen.compact-width #task-bar #project-label {
    height: 1;
    margin-right: 0;
}

#screen.compact-width #task-bar Button {
    height: 3;
}

#screen.compact-width #output {
    width: 1fr;
}

/* Short terminals keep the output flexible by reducing surrounding chrome. */
#screen.short-height #task-context {
    height: 1;
}

#screen.short-height #output-toolbar,
#screen.short-height #actions,
#screen.short-height #plan-actions {
    height: 2;
}

#screen.short-height #resume-notes-panel {
    height: 4;
}

#screen.short-height #resume-notes {
    height: 2;
}

#screen.short-height #actions Button,
#screen.short-height #output-toggle-button,
#screen.short-height #plan-actions Button {
    height: 2;
}

KeyboardShortcutsScreen {
    align: center middle;
}

CodingStatisticsScreen {
    align: center middle;
}

ProjectInitializerScreen {
    align: center middle;
}

OpenProjectDirectoryScreen {
    align: center middle;
}

CreateTopicScreen {
    align: center middle;
}

TopicViewerScreen {
    align: center middle;
}

#topic-view-dialog {
    width: 90%;
    height: 85%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#topic-view-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#topic-view-subtitle {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

#topic-view-content {
    height: 1fr;
    border: round $primary;
    margin-bottom: 1;
}

#topic-view-actions {
    height: 3;
    align: right middle;
}

#close-topic-view-button {
    width: 10;
}

#create-topic-dialog {
    width: 82;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#create-topic-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#create-topic-subtitle, #topic-name-label, #topic-goal-label, #create-topic-status {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#topic-name-input {
    margin-bottom: 1;
}

#topic-goal-input {
    height: 10;
    margin-bottom: 1;
}

#create-topic-actions {
    height: 3;
    align: left middle;
}

#create-topic-button, #cancel-topic-button {
    width: 20;
    margin-right: 1;
}

#project-initializer-dialog {
    width: 72;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#project-initializer-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#project-initializer-subtitle, #project-name-label, #project-initializer-status {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

#project-name-input {
    margin-bottom: 1;
}

#project-github-checkbox {
    margin-bottom: 1;
}

#project-initializer-actions {
    height: 3;
    align: left middle;
}

#open-directory-dialog {
    width: 72;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#open-directory-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#open-directory-subtitle, #open-directory-status {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

#open-directory-input {
    margin-bottom: 1;
}

#open-directory-actions {
    height: 3;
    align: left middle;
}

#plan-clarification-dialog {
    width: 72;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#plan-clarification-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#plan-clarification-question {
    color: $text;
    height: auto;
    margin-bottom: 1;
}

#plan-clarification-subtitle {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#plan-clarification-input {
    height: 6;
    margin-bottom: 1;
}

#plan-clarification-actions {
    height: 3;
    align: left middle;
}

#coding-statistics-dialog {
    width: 94%;
    height: 88%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#pushed-commits-dialog {
    width: 94%;
    height: 78%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#pushed-commits-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#pushed-commits-subtitle {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

#pushed-commits-content {
    height: 1fr;
    border: round $primary;
    margin-bottom: 1;
}

#pushed-commits-footer {
    color: $text-muted;
    height: 1;
}

#coding-statistics-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#coding-statistics-subtitle, #coding-statistics-footer {
    color: $text-muted;
    height: 1;
}

#coding-statistics-controls {
    height: 3;
    align: left middle;
}

#statistics-unit-label {
    width: 9;
    color: $text-muted;
}

#statistics-unit-select {
    width: 18;
}

#coding-statistics-summary {
    height: 5;
    margin-top: 1;
}

.usage-metric {
    width: 1fr;
    border: round $secondary;
    padding: 1;
    color: $text-accent;
    text-style: bold;
    margin-right: 1;
}

#coding-statistics-body {
    height: 1fr;
    margin-top: 1;
}

#usage-history-panel {
    width: 58%;
    border: round $primary;
    padding: 1;
    margin-right: 1;
}

#usage-breakdown-panel {
    width: 42%;
    border: round $primary;
    padding: 1;
}

.statistics-heading {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

.statistics-value {
    color: $text;
    height: 3;
    margin-bottom: 1;
}

#provider-split {
    height: auto;
}

#usage-table {
    height: 1fr;
}

#shortcuts-dialog {
    width: 72;
    max-height: 90%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#shortcuts-title {
    color: $text-accent;
    text-style: bold;
    height: 2;
}

#shortcuts-subtitle {
    color: $text-muted;
    height: 2;
}

.shortcut-section {
    color: $text-accent;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

.shortcut-row {
    height: 1;
}

#sign-in-dialog, #backend-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#sign-in-title, #backend-title {
    color: $text-accent;
    text-style: bold;
}

#sign-in-mode, #backend-subtitle, #backend-note {
    color: $text-muted;
    margin-bottom: 1;
}

#sign-in-detail, #backend-registered, #backend-status {
    height: auto;
    margin-bottom: 1;
}

#backend-select {
    margin-bottom: 1;
}

#sign-in-actions, #backend-actions {
    height: auto;
    align: right middle;
}

#sign-in-actions Button, #backend-actions Button {
    margin-left: 1;
}

#project-backend-label {
    margin-top: 1;
}
